{
  // ルールの層 (src/domain) と CPU の思考 (src/ai) だけを対象にした型検査。
  //
  // CPU の思考を含めるのは、画面を出さずに大量の試合を回して強さを
  // 測るため。CPU がブラウザ API に触れていると、その検証ができなくなる。
  //
  // この設定の主眼は "lib" に "DOM" を入れないことと "types" を空にすること。
  // これにより domain/ の中に document や window と書いた時点で
  // 「名前が見つからない」という型エラーになる。レビューでの指摘や
  // 命名規約ではなく、コンパイラが落とす。
  //
  // ⚠️ この設定を緩めると、層の境界を守る仕組みが1つ失われる。
  // 実時間や乱数 (Math.random / Date.now) は ES2022 の一部なので
  // 型検査では止まらない。そちらは ESLint の no-restricted-globals で禁じている。
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": [],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,

    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/domain", "src/ai"]
}
